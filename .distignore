# Files and directories that should NOT be shipped to the WordPress.org
# SVN repository / release zip. Everything else in the plugin root is deployed.

/.git
/.github
/.claude
/.gitignore
/.gitattributes
/.distignore
/.wordpress-org
/node_modules
/README.md
/CLAUDE.md
# Translations are managed via translate.wordpress.org for hosted plugins, so
# the source translation files are kept in the repo but not shipped in the package.
/languages
